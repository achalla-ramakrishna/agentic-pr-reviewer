{
  "info": {
    "name": "SkyRoute API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "flightId",
      "value": ""
    },
    {
      "key": "pnr",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login (agent)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"agent\",\n  \"password\": \"agent123\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Search flights",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/flights/search?origin=DFW&destination=JFK&date=2026-11-01&cabin=ECONOMY&passengers=1&sort=FARE",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "flights",
            "search"
          ],
          "query": [
            {
              "key": "origin",
              "value": "DFW"
            },
            {
              "key": "destination",
              "value": "JFK"
            },
            {
              "key": "date",
              "value": "2026-11-01"
            },
            {
              "key": "cabin",
              "value": "ECONOMY"
            },
            {
              "key": "passengers",
              "value": "1"
            },
            {
              "key": "sort",
              "value": "FARE"
            }
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "if (body.length) pm.collectionVariables.set('flightId', body[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "bookings"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contactEmail\": \"ana@example.com\",\n  \"passengers\": [\n    {\n      \"firstName\": \"Ana\",\n      \"lastName\": \"Diaz\",\n      \"type\": \"ADT\"\n    }\n  ],\n  \"segments\": [\n    {\n      \"flightId\": \"{{flightId}}\",\n      \"cabin\": \"ECONOMY\"\n    }\n  ]\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('pnr', pm.response.json().recordLocator);"
            ]
          }
        }
      ]
    },
    {
      "name": "My bookings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "bookings"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Get booking",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/bookings/{{pnr}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "bookings",
            "{{pnr}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Cancel booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/bookings/{{pnr}}/cancel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "bookings",
            "{{pnr}}",
            "cancel"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Validation error example",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/flights/search?origin=DALLAS&destination=JFK&date=2026-11-01",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "flights",
            "search"
          ],
          "query": [
            {
              "key": "origin",
              "value": "DALLAS"
            },
            {
              "key": "destination",
              "value": "JFK"
            },
            {
              "key": "date",
              "value": "2026-11-01"
            }
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 problem+json', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().errorCode).to.eql('VALIDATION_FAILED'); });"
            ]
          }
        }
      ]
    }
  ]
}